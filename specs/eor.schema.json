{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioverity.org/specs/eor.schema.json",
  "title": "Ecological Observation Record",
  "type": "object",
  "required": ["observation_id", "species_id", "observed_at", "location", "source", "quality"],
  "properties": {
    "observation_id": { "type": "string" },
    "species_id": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "required": ["lat", "lon", "ecoregion"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "ecoregion": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["provider", "source_id"],
      "properties": {
        "provider": { "type": "string" },
        "source_id": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["coordinate_uncertainty_m", "confidence"],
      "properties": {
        "coordinate_uncertainty_m": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

