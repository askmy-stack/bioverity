{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioverity.org/specs/eer.schema.json",
  "title": "Ecological Evidence Record",
  "type": "object",
  "required": ["evidence_id", "claim_id", "evidence_type", "direction", "source_ids", "strength", "quality_score", "provenance"],
  "properties": {
    "evidence_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "evidence_type": { "type": "string" },
    "direction": { "enum": ["supporting", "contradicting", "contextual"] },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": { "$ref": "policy.schema.json#/$defs/provenance" }
  }
}

