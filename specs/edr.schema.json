{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioverity.org/specs/edr.schema.json",
  "title": "Ecological Decision Record",
  "type": "object",
  "required": ["decision_id", "claim_id", "decision_type", "candidate_actions", "selected_action", "confidence", "requires_human_review", "evidence_snapshot_id", "model_version", "policy_version"],
  "properties": {
    "decision_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "decision_type": { "type": "string" },
    "candidate_actions": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "selected_action": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_human_review": { "type": "boolean" },
    "evidence_snapshot_id": { "type": "string" },
    "model_version": { "type": "string" },
    "policy_version": { "type": "string" }
  }
}

